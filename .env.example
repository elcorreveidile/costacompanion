# ── Base de datos (Neon / Postgres) ───────────────────────────────────────────
# Connection string con pooling de Neon (host con sufijo `-pooler`).
DATABASE_URL=

# ── Autenticación (Auth.js) ───────────────────────────────────────────────────
# Secreto para firmar los JWT de sesión. Genera uno con: openssl rand -base64 32
AUTH_SECRET=

# ── Supabase (en retirada — se elimina al completar la migración a Neon) ───────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # NUNCA exponer al cliente — solo en servidor

# ── Email (Brevo SMTP) ────────────────────────────────────────────────────────
# Mismas credenciales que se configuran en Supabase Auth (custom SMTP) para el
# enlace mágico, de modo que todo el correo saliente pasa por Brevo.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587                 # 587 = STARTTLS; 465 = SSL
BREVO_SMTP_USER=                    # login SMTP de Brevo
BREVO_SMTP_KEY=                     # clave SMTP (master password) de Brevo
EMAIL_FROM=Costa Companion <hola@costacompanion.com>

# ── Stripe del operador (cuotas a acompañantes y anunciantes) ─────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Precios acompañante
STRIPE_PRICE_ACOMP_LAUNCH=          # 19 €/mes (tarifa lanzamiento, primer año)
STRIPE_PRICE_ACOMP_STANDARD=        # 39 €/mes (tarifa estándar, a partir del 2.º año)
STRIPE_PRICE_ACOMP_SETUP=           # 99 € único (alta)

# Precios anunciante (Local Partner)
STRIPE_PRICE_PARTNER_BASIC=         # 29 €/mes
STRIPE_PRICE_PARTNER_FEATURED=      # 79 €/mes

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://costacompanion.com
